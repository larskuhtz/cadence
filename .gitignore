# Lake build tree: oleans, the fetched dependencies, and the Veil proof cache
# (.lake/build/veilcache/ — safe to delete at any time; it only ever skips
# proof *search*, never checking).
.lake/

# The protocol paper is a separate, access-restricted repository. Nothing here
# needs it to build; clone it into papers/cadence if you have access (see
# README.md) and it stays out of this repository's history.
/papers/

# Staging area for the container build context's proof-cache seed: the
# directory and its .keep are tracked (so an unseeded `podman build` works),
# the ~4 GB of cache entries scripts/container.sh puts there are not.
/.veilcache-seed/*
!/.veilcache-seed/.keep

# Editor / OS noise
.vscode/
.DS_Store
